# FED-Indeed — .gitignore

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
wheels/
pip-wheel-metadata/

# --- Virtual environments ---
venv/
.venv/
env/
ENV/
.python-version

# --- Environment / secrets ---
.env
.env.*
*.key
*.pem

# --- Streamlit ---
.streamlit/secrets.toml

# --- Test & tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# --- Editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Sample uploads & local scratch (never commit candidate data) ---
uploads/
sample_resumes/
*.local.pdf
_*.pdf

# --- Docs build artifacts ---
docs/_build/
site/
